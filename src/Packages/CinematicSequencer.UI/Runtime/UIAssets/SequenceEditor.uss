/* ==========================================================================
   CinematicSequencer v2 — SequenceEditor Styles
   Sidebar layout, track headers, track content, clips, keyframes
   ========================================================================== */

/********** Layout — Sidebar **********/
.sequence-editor-root {
    width: 100%;
    height: 100%;
    flex-direction: row;
    background-color: var(--panel-bg);
}

/* Left sidebar: Library */
.library-panel {
    width: 240px;
    min-width: 180px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: #222222;
    background-color: #333333;
    flex-direction: column;
    overflow: hidden;
}

/* Right: Editor area (toolbar + timeline) */
.editor-area {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

/********** Playback toolbar container **********/
.playback-toolbar-container {
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: #222222;
}

/********** Timeline layout — Track headers + clips side by side **********/
.sequence-panel {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* Track headers column (corner + scrollable list) */
.track-headers-panel {
    width: var(--track-header-width);
    flex-shrink: 0;
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: #222222;
    background-color: #333333;
}

/* Corner cell (aligns with time-ruler height) */
.track-headers-corner {
    height: var(--ruler-height);
    background-color: var(--header-bg);
    border-bottom-width: 1px;
    border-bottom-color: #222222;
    justify-content: center;
    padding: 0 8px;
    flex-shrink: 0;
}

.track-headers-corner__label {
    color: #AAAAAA;
    font-size: 11px;
    -unity-font-style: bold;
}

.track-headers-scroll-view {
    flex-grow: 1;
    background-color: #333333;
}

.track-headers-container {
    flex-grow: 1;
}

/* Timeline column */
.timeline-panel {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--panel-bg);
    min-width: 0;
}

.time-ruler {
    height: var(--ruler-height);
    background-color: var(--header-bg);
    border-bottom-width: 1px;
    border-bottom-color: #222222;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
}

.tracks-scroll-view {
    flex-grow: 1;
}

.tracks-container {
    flex-grow: 1;
    min-height: 100%;
}

.dialog-layer {
    position: absolute;
    width: 100%;
    height: 100%;
    display: none;
}

/********** Track headers **********/
.track-header {
    height: var(--track-height);
    padding: 0 8px;
    background-color: #3d3d3d;
    border-bottom-width: 1px;
    border-bottom-color: #2a2a2a;
    border-left-width: 3px;
    border-left-color: transparent;
    justify-content: center;
}

.track-header:hover {
    background-color: #484848;
}

.track-header__name {
    color: #E0E0E0;
    font-size: 12px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.track-name {
    color: #E0E0E0;
    font-size: 12px;
    -unity-text-align: middle-left;
}

/* Track type left border colors */
.track-camera {
    border-left-color: var(--camera-clip-color);
}

.track-light {
    border-left-color: var(--light-clip-color);
}

.track-effect {
    border-left-color: var(--effect-clip-color);
}

.track-audio {
    border-left-color: var(--audio-clip-color);
}

.track-motion {
    border-left-color: var(--motion-clip-color);
}

.track-posteffect {
    border-left-color: var(--posteffect-clip-color);
}

.track-default {
    border-left-color: #888888;
}

/********** Track content rows **********/
.track-row {
    height: var(--track-height);
    flex-direction: row;
    background-color: var(--track-bg);
    border-bottom-width: 1px;
    border-bottom-color: #2a2a2a;
    position: relative;
}

/* Alternate row color applied via C# (TrackContentView adds .track-row-alt) */
.track-row-alt {
    background-color: var(--track-bg-alt);
}

/********** Clips **********/
.sequence-clip {
    position: absolute;
    height: 100%;
    border-radius: var(--clip-border-radius);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.3);
    overflow: hidden;
}

.sequence-clip:hover {
    border-color: rgba(255, 255, 255, 0.4);
}

.sequence-clip.selected {
    border-width: 2px;
    border-color: var(--selection-border-color);
}

.sequence-clip__name {
    color: rgba(0, 0, 0, 0.8);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.timeline-clip {
    position: absolute;
    height: var(--track-height);
    border-radius: var(--clip-border-radius);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.3);
}

.clip-label {
    color: rgba(0, 0, 0, 0.8);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Clip type background colors */
.clip-camera {
    background-color: var(--camera-clip-color);
}

.clip-light {
    background-color: var(--light-clip-color);
}

.clip-effect {
    background-color: var(--effect-clip-color);
}

.clip-audio {
    background-color: var(--audio-clip-color);
}

.clip-motion {
    background-color: var(--motion-clip-color);
}

.clip-posteffect {
    background-color: var(--posteffect-clip-color);
}

.clip-default {
    background-color: #888888;
}

/* Legacy clip type classes (v1 compatibility) */
.camera-clip {
    background-color: var(--camera-clip-color);
}

.light-clip {
    background-color: var(--light-clip-color);
}

.audio-clip {
    background-color: var(--audio-clip-color);
}

/********** Keyframe track **********/
.keyframe-track-row {
    height: var(--track-height);
    flex-direction: row;
    align-items: center;
    background-color: var(--track-bg);
    border-bottom-width: 1px;
    border-bottom-color: #2a2a2a;
    padding-left: 5px;
    padding-right: 5px;
    position: relative;
}

.keyframe-marker {
    position: absolute;
    width: 15px;
    height: 15px;
    background-color: rgb(255, 255, 0);
    border-radius: 0;
    transform-origin: center;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
    rotate: 45deg;
}

.keyframe-marker:hover {
    background-color: rgb(255, 255, 150);
    border-color: rgb(255, 255, 255);
}

.keyframe-marker.selected {
    background-color: rgb(255, 165, 0);
    border-color: rgb(255, 255, 255);
    border-width: 2px;
}
